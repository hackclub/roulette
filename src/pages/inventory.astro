---
import InsideLayout from '../layouts/InsideLayout.astro';
import { requireUser, redirectToLogin } from '../lib/auth.js';

let userData;

export const prerender = false;

try {
  userData = await requireUser(Astro.request.headers);
} catch {
  return redirectToLogin();
}

var user = userData.fields;
---

<InsideLayout currentPage="inventory">
<main>
  <h1>🎒 your inventory</h1>
  <p>here's everything you've collected and purchased!</p>
  
  <div class="user-balance">
    <p>you have <strong>{user.chips}</strong> chips available</p>
  </div>
  
  <div class="inventory-sections">
    <!-- Purchases Section -->
    <section class="purchases-section">
      <h2>🛍️ your purchases</h2>
      <div id="purchases-container" class="items-grid">
        <div class="loading">loading your purchases...</div>
      </div>
    </section>
  </div>
</main>
</InsideLayout>

<style is:global>
  main {
    padding: 40px;
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    box-sizing: border-box;
    overflow-y: auto;
  }
  
  h1 {
    color: var(--pink);
    text-align: center;
    margin-bottom: 16px;
    font-size: 2.5em;
  }
  
  main > p {
    text-align: center;
    color: var(--pink);
    margin-bottom: 40px;
    font-size: 1.2em;
    opacity: 0.9;
  }
  
  .user-balance {
    text-align: center;
    background: rgba(255, 105, 138, 0.1);
    border: 1px solid var(--pink);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 40px;
  }
  
  .user-balance p {
    margin: 0;
    color: var(--pink);
    font-size: 1.2em;
  }
  
  .user-balance strong {
    color: var(--pink);
    font-size: 1.4em;
  }
  
  .inventory-sections {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  
  section h2 {
    color: var(--pink);
    margin-bottom: 20px;
    font-size: 1.8em;
    text-align: center;
  }
  
  .items-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 15px;
  }
  
  .purchase-item {
    background: rgba(0, 0, 0, 0.6);
    border: 2px solid var(--pink);
    border-radius: 12px;
    padding: 12px;
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  
  .purchase-item .item-image {
    width: 80%;
    object-fit: contain;
    margin-bottom: 8px;
  }
  
  .purchase-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(255, 105, 138, 0.3);
  }
  
  .purchase-item h3 {
    color: var(--pink);
    margin: 0 0 6px 0;
    font-size: 0.9em;
    line-height: 1.2;
  }
  
  .purchase-item .item-type {
    color: var(--pink);
    opacity: 0.7;
    font-size: 0.7em;
    margin: 2px 0 0 0;
    text-transform: uppercase;
    font-weight: 600;
  }
  
  .purchase-item .total-cost {
    color: var(--pink);
    font-weight: 700;
    font-size: 0.7em;
    margin: 4px 0 0 0;
    background: rgba(255, 105, 138, 0.1);
    padding: 2px 6px;
    border-radius: 3px;
    display: inline-block;
  }
  
  .loading {
    text-align: center;
    color: var(--pink);
    opacity: 0.7;
    font-style: italic;
    grid-column: 1 / -1;
  }
  
  .empty-state {
    text-align: center;
    color: var(--pink);
    opacity: 0.7;
    font-style: italic;
    grid-column: 1 / -1;
    padding: 40px;
  }
  
  @media (max-width: 768px) {
    .items-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    
    main {
      padding: 20px;
    }
    
    h1 {
      font-size: 2em;
    }
  }
</style>

<script>
  async function loadInventory() {
    try {
      // Load both inventory and stickers data
      const [inventoryResponse, stickersResponse] = await Promise.all([
        fetch('/api/inventory'),
        fetch('/api/stickers')
      ]);
      
      const inventoryData = await inventoryResponse.json();
      const stickersData = await stickersResponse.json();
      
      console.log('Inventory API response:', inventoryData);
      console.log('Stickers API response:', stickersData);
      
      if (inventoryData.success) {
        console.log('Purchases data:', inventoryData.data.purchases);
        console.log('Full stickers response:', stickersData);
        
        // Handle stickers data properly
        let stickers = [];
        if (stickersData && stickersData.success && Array.isArray(stickersData.stickers)) {
          stickers = stickersData.stickers;
        } else if (Array.isArray(stickersData)) {
          stickers = stickersData;
        }
        
        console.log('Processed stickers:', stickers);
        loadPurchases(inventoryData.data.purchases, stickers);
      } else {
        console.error('Failed to load inventory:', inventoryData.error);
      }
    } catch (error) {
      console.error('Error loading inventory:', error);
    }
  }
  
  function loadPurchases(purchases, stickers = []) {
    const container = document.getElementById('purchases-container');
    
    console.log('loadPurchases called with:', purchases);
    console.log('purchases.length:', purchases ? purchases.length : 'undefined');
    console.log('stickers:', stickers);
    
    if (!purchases || purchases.length === 0) {
      container.innerHTML = '<div class="empty-state">no purchases yet! visit the cash-in page to spend your chips.</div>';
      return;
    }
    
    // Prize data from cash-in.astro (same images)
    const prizeData = {
      "spin for a sticker": "/prizes/random sticker.png",
      "pick a sticker": "/prizes/sticker.png",
      "$10 steam gift card": "/prizes/steam.png",
      "$10 itch.io credit": "/prizes/itch.png",
      "aseprite": "/prizes/aseprite.png",
      "$25 fangamer gift card": "/prizes/fangamer.png",
      "$30 soft toy credit": "/prizes/soft toys.png",
      "steam publishing credit": "/prizes/steam grant.png",
      "$400 console grant": "/prizes/console.png"
    };
    
    // Group purchases by item name only (ignore chips spent differences)
    const groupedPurchases = {};
    purchases.forEach(purchase => {
      const key = purchase.itemName;
      if (!groupedPurchases[key]) {
        groupedPurchases[key] = {
          itemName: purchase.itemName,
          itemType: purchase.itemType,
          count: 0
        };
      }
      groupedPurchases[key].count++;
    });
    
    // Convert to array and sort by count (most frequent first)
    const groupedArray = Object.values(groupedPurchases).sort((a, b) => b.count - a.count);
    
    container.innerHTML = groupedArray.map(item => {
      // Get image for this item
      let imageSrc = prizeData[item.itemName];
      
      // If it's a sticker and not in prizeData, look in stickers array
      if (!imageSrc && item.itemType === 'sticker') {
        console.log('Looking for sticker:', item.itemName);
        console.log('Available stickers:', Array.isArray(stickers) ? stickers.map(s => s.stickerName) : 'Not an array');
        const sticker = Array.isArray(stickers) ? stickers.find(s => s.stickerName === item.itemName) : null;
        console.log('Found sticker:', sticker);
        imageSrc = sticker ? sticker.stickerImage : '/prizes/sticker.png';
      }
      
      // Fallback image
      if (!imageSrc) {
        imageSrc = '/prizes/sticker.png';
      }
      
      return `
        <div class="purchase-item">
          <img src="${imageSrc}" alt="${item.itemName}" class="item-image" />
          <h3>${item.itemName}${item.count > 1 ? ` ×${item.count}` : ''}</h3>
          <p class="item-type">${item.itemType}</p>
        </div>
      `;
    }).join('');
  }
  
  // Load inventory when page loads
  document.addEventListener('DOMContentLoaded', loadInventory);
</script>
